# ==============================================================================
# GALA & PR OPERASYON PLATFORMU (B2B SaaS) — ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & PORTS
# ------------------------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
WEB_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. DATABASE (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_USER=gala_admin
POSTGRES_PASSWORD=gala_secret_dev_pass
POSTGRES_DB=gala_pr_db
POSTGRES_PORT=5432
DATABASE_URL="postgresql://gala_admin:gala_secret_dev_pass@localhost:5432/gala_pr_db?schema=public&sslmode=prefer"

# ------------------------------------------------------------------------------
# 3. REDIS & QUEUE (BullMQ, Rate Limit, TOTP Nonce Cache)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=gala_redis_dev_pass

# ------------------------------------------------------------------------------
# 4. KVKK & KRİPTOGRAFİK GÜVENLİK ANAHTARLARI
# ------------------------------------------------------------------------------
# FIELD_ENCRYPTION_KEY:
# PII (Kişisel Veri - e-posta, telefon, mesaj gövdesi vb.) alanlarını şifrelemek için AES-256-GCM kullanılır.
# 32-byte (256-bit) rastgele binary değerin Hex veya Base64 formatı olmalıdır.
# Üretmek için: `openssl rand -hex 32` veya `node -e "console.log(crypto.randomBytes(32).toString('hex'))"`
FIELD_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# BLIND_INDEX_SALT:
# AES-256-GCM deterministik olmadığı için aynı metin her defasında farklı şifrelenir.
# E-posta ve telefon üzerinde birebir eşleşme araması (exact-match lookups) ve UNIQUE kısıtı sağlayabilmek için
# HMAC-SHA256 ile üretilen "Blind Index" kullanılır. Bu salt gizli tutulmalıdır.
# Üretmek için: `openssl rand -hex 32`
BLIND_INDEX_SALT="fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210"

# TOTP_MASTER_SECRET:
# Dinamik QR biletlerin kapı girişinde TOTP/HMAC tabanlı doğrulanması için kullanılan platform anahtarı.
# Üretmek için: `openssl rand -base64 32`
TOTP_MASTER_SECRET="K7v9mQx2+L8wZpRt1sDu9yC4fG6hJn3kLpQrStUvWxY="

# ------------------------------------------------------------------------------
# 5. AUTHENTICATION & JWT
# ------------------------------------------------------------------------------
# JWT_SECRET: Kullanıcı oturum ve API yetkilendirme belirteçleri için kullanılan gizli anahtar.
JWT_SECRET="super-secret-jwt-key-change-in-production-min-32-chars-long"
JWT_EXPIRES_IN="7d"

# ------------------------------------------------------------------------------
# 6. EMAIL PROVIDER (Resend)
# ------------------------------------------------------------------------------
# RESEND_API_KEY: Davetiye ve bildirim e-postaları gönderimi için Resend API anahtarı.
RESEND_API_KEY="re_1234567890abcdef"
# RESEND_WEBHOOK_SECRET: Gelen (Inbound) e-postaların imzasını (Svix/Resend webhook) doğrulamak için secret.
RESEND_WEBHOOK_SECRET="whsec_1234567890abcdef"
EMAIL_FROM_ADDRESS="gala@operasyon.domain.com"
EMAIL_INBOUND_DOMAIN="rsvp.domain.com"

# ------------------------------------------------------------------------------
# 7. AI & LLM PROVIDERS
# ------------------------------------------------------------------------------
# OPENAI_API_KEY: Gelen e-postaların niyet analizi (LCV / +1 / soru) ve taslak yanıt üretimi için.
OPENAI_API_KEY="sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
AI_MODEL="gpt-4o"
