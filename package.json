{
  "name": "gala-pr-operations-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Gala & PR Operasyon Platformu (B2B SaaS) - Monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "node packages/database/scripts/run-all.cjs",
    "test:suites": "node packages/database/scripts/run-all.cjs",
    "test:turbo": "turbo run test",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:generate": "pnpm --filter @gala/database db:generate",
    "db:migrate": "pnpm --filter @gala/database db:migrate",
    "db:studio": "pnpm --filter @gala/database db:studio",
    "db:seed": "node packages/database/scripts/seed-runner.cjs"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0"
}
